class Solution {
public:
    string greatestLetter(string s) {
        bool upper[26]={false};
        bool lower[26]={false};
        for(char ch : s){
            if(ch >='a' && ch <= 'z')
               lower[ch - 'a']=true;
            else if(ch >='A' && ch <= 'Z')
               upper[ch - 'A']=true;
        }

        for(int i=25;i>=0;i--){
            if(lower[i] && upper[i]){
                return string(1, 'A'+i);
            }
        }
        return "";
    }
};
